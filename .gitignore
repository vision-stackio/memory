# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Secrets - never commit your API key (.env.example stays tracked)
.env
.env.*
!.env.example

# Local memory data (created on first run: static, dynamic, conceptual)
# Keep your seed files in seed/ - those ARE tracked.
data/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Package manager caches
.npm/
.yarn/
.pnpm-store/

# Editors and IDEs
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Test / coverage output
coverage/
.nyc_output/
